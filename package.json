{
  "name": "vadkit",
  "version": "0.2.0",
  "description": "Multi-provider voice activity detection for the browser",
  "keywords": [
    "vad",
    "voice-activity-detection",
    "speech",
    "audio",
    "webaudio",
    "onnx"
  ],
  "license": "MIT",
  "author": "Will Rice",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "models",
    "THIRD_PARTY_NOTICES"
  ],
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fireredvad": {
      "types": "./dist/providers/fireredvad.d.ts",
      "default": "./dist/providers/fireredvad.js"
    },
    "./silero": {
      "types": "./dist/providers/silero.d.ts",
      "default": "./dist/providers/silero.js"
    },
    "./webrtc": {
      "types": "./dist/providers/webrtc.d.ts",
      "default": "./dist/providers/webrtc.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack && publint && attw --pack --profile esm-only",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "vp fmt -c .oxfmtrc.json",
    "format:check": "vp fmt --check -c .oxfmtrc.json",
    "test": "vp test run",
    "test:watch": "vp test",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "prepare": "husky",
    "fixtures": "uv run scripts/generate_fireredvad_fixture.py && uv run scripts/generate_silero_fixture.py && uv run scripts/generate_webrtc_fixture.py",
    "demo": "vp dev demo"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "onnxruntime-web": ">=1.17.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@arethetypeswrong/core": "^0.18.5",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^22.20.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "onnxruntime-web": "^1.29.0",
    "publint": "^0.3.24",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0"
  },
  "lint-staged": {
    "*.{ts,mts,mjs}": [
      "vp fmt -c .oxfmtrc.json",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{json,jsonc,yaml,yml,md,html,css}": [
      "vp fmt -c .oxfmtrc.json --no-error-on-unmatched-pattern"
    ],
    "*.py": [
      "uvx ruff format",
      "uvx ruff check --fix"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/will-rice/vadkit.git"
  },
  "homepage": "https://github.com/will-rice/vadkit#readme",
  "bugs": {
    "url": "https://github.com/will-rice/vadkit/issues"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.5.0",
      "onFail": "download"
    }
  }
}
