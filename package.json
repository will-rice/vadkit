{
  "name": "vadkit",
  "version": "0.1.0",
  "description": "Multi-provider voice activity detection for the browser",
  "keywords": [
    "vad",
    "voice-activity-detection",
    "speech",
    "audio",
    "webaudio",
    "onnx"
  ],
  "license": "MIT",
  "author": "Will Rice",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "models"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fireredvad": {
      "types": "./dist/providers/fireredvad.d.ts",
      "default": "./dist/providers/fireredvad.js"
    },
    "./silero": {
      "types": "./dist/providers/silero.d.ts",
      "default": "./dist/providers/silero.js"
    },
    "./webrtc": {
      "types": "./dist/providers/webrtc.d.ts",
      "default": "./dist/providers/webrtc.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "fixtures": "uv run scripts/generate_fireredvad_fixture.py && uv run scripts/generate_silero_fixture.py",
    "demo": "vite"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "onnxruntime-web": ">=1.17.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "onnxruntime-web": "^1.29.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,mts,mjs}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{json,yaml,yml,md,html,css}": [
      "prettier --write --ignore-unknown"
    ],
    "*.py": [
      "uvx ruff format",
      "uvx ruff check --fix"
    ]
  }
}
